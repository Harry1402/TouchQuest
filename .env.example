# TouchQuest Environment Variables
# Hacktoberfest 2026 Open-Source AI Challenge

# Option 1: Hosted Inference via Google AI Studio (Recommended for Production & Render)
# Fast, multimodal, and generous free tier for text + vision quest generation.
GEMMA_API_KEY=
GEMMA_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMMA_MODEL=gemini-3.5-flash

# Option 2: 100% Private Local Inference via Ollama (On-Device)
# Run Gemma 3 locally: `ollama run gemma3:4b`
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b
# GEMMA_VISION_MODEL=gemma3:4b

# Option 3: Optional Dedicated Vision Endpoint Overrides
# (If different from default GEMMA_MODEL / GEMMA_API_KEY)
# GEMMA_VISION_API_KEY=
# GEMMA_VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Note: If no API key or Ollama instance is configured, TouchQuest seamlessly runs in
# "Curated Sample Mode", delivering handcrafted, safe nature quests for testing and evaluation.
