# TouchQuest Environment Variables
# Hacktoberfest 2026 Open-Source AI Challenge

# Option 1: Hosted Gemma API (Groq / OpenRouter / Hugging Face / Google AI Studio)
# Fast, hosted open weights inference.
GEMMA_API_KEY=
GEMMA_API_BASE_URL=https://api.groq.com/openai/v1
GEMMA_MODEL=gemma2-9b-it

# Option 2: Local Gemma via Ollama (Optional)
# If running locally with Ollama (ollama run gemma2:2b or gemma2:9b)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma2:2b

# Option 3: Multimodal Gemma Vision ("Look Once. See More.")
# Target local vision model (e.g. gemma3:4b or llava) via Ollama:
GEMMA_VISION_MODEL=gemma3:4b
# Optional hosted vision overrides (requires user consent to transmit snapshot):
# GEMMA_VISION_API_KEY=
# GEMMA_VISION_BASE_URL=https://api.groq.com/openai/v1

# Note: If no API key or Ollama instance is configured, TouchQuest seamlessly runs in
# "Curated Sample Mode", delivering handcrafted, safe nature quests for testing and evaluation.
